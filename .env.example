# 复制为 .env 并按需修改；所有项均可省略
# 对外 API key（OpenAI 风格 Bearer 鉴权）。未设置时首次启动会自动生成并持久化到 data/gateway-key.json
GATEWAY_API_KEY=sk-libtv-change-me

# 监听端口
GATEWAY_PORT=8787

# 页面授权开关（可选，Docker 场景通常不需要）
# LibTV 官方只接受 127.0.0.1 / localhost 回调（内网IP/公网域名会被 invalid_redirect_uri 拒绝）。
# 若要在 /auth 页面直接点按钮授权，把它设为浏览器可访问的 loopback 地址，例如：
#   GATEWAY_PUBLIC_URL=http://127.0.0.1:8787   （Docker 用 -p 8787:8787 端口映射即可）
# 不设置时，/auth 页面会引导你在宿主机用 `npm run auth:login` 扫码，再把凭据挂载进容器（推荐）。
# GATEWAY_PUBLIC_URL=

# LibTV 画布 uuid（list_projects 返回的 uuid 字段，不是数字 id）
# 必填：授权后用 `npm run call -- list_projects '{}'` 查出自己的画布 uuid 填这里
LIBTV_PROJECT_ID=

# 默认模型（请求里可用 model 字段覆盖；候选见 GET /v1/models）
DEFAULT_IMAGE_MODEL=lib-image-2.6-a
DEFAULT_VIDEO_MODEL=motion-3.1-lite

# 稳定性调优（默认值已按单账号自用场景校准）
# MAX_CONCURRENT_GENERATIONS=3   单账号并发上限（额度保护）
# SUBMIT_RETRIES=4               提交层重试次数（幂等键复用）
# FAILED_TASK_RETRIES=1          终态失败后换新幂等键重试次数
# POLL_INTERVAL_MS=3000          轮询间隔
# IMAGE_TIMEOUT_MS=300000        图像生成超时（5 分钟）
# VIDEO_TIMEOUT_MS=1500000       视频生成超时（25 分钟）
# AUTH_REFRESH_MAX_FAILURES=3    refresh 连续失败达此次数后自动删除 data/LibTV.lock 并重新开放 /auth

# 结果镜像与清理
# MIRROR_RESULTS=false           默认直接返回 LibTV 原始直链；设 true 则转存到 data/results/ 并返回网关地址 /files/<jobId>
# FILES_RETENTION_HOURS=168      仅镜像开启时生效：本地镜像保留时长（小时，0=永久），过期自动删除
# CLEANUP_CANVAS_NODES=true      生成成功后删除本次在画布上创建的节点（生成节点+参考图节点）
